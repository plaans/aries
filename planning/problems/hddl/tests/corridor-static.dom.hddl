; Issue plaans/aries#284: `move` must not be rolled up into a single subtask (`link` is static)
(define (domain corridor)
  (:requirements :typing :hierarchy :negative-preconditions)
  (:types room)
  (:predicates (at ?r - room) (link ?a ?b - room))
  (:task go :parameters (?to - room))
  (:method go-here :parameters (?to - room) :task (go ?to)
    :precondition (at ?to) :ordered-subtasks ())
  (:method go-step :parameters (?a ?b ?to - room) :task (go ?to)
    :precondition (at ?a)
    :ordered-subtasks (and (t1 (move ?a ?b)) (t2 (go ?to))))
  (:action move :parameters (?a ?b - room)
    :precondition (and (at ?a) (link ?a ?b))
    :effect (and (not (at ?a)) (at ?b))))
